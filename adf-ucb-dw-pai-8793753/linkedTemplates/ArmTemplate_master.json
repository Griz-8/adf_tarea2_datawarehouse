{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-ucb-dw-pai-8793753"
		},
		"LS_AzureDataLake_PAI_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_AzureDataLake_PAI'"
		},
		"LS_AzureSqlDatabase_PAI_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_AzureSqlDatabase_PAI'"
		},
		"LS_AzureDataLake_PAI_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://saucbpai8793753.dfs.core.windows.net/"
		},
		"LS_AzureSqlDatabase_PAI_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-ucb-sisger-pai-8793753.database.windows.net"
		},
		"LS_AzureSqlDatabase_PAI_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "dw_pai_bolivia"
		},
		"LS_AzureSqlDatabase_PAI_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "michelle"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-ucb-dw-pai-8793753_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_AzureDataLake_PAI_accountKey": {
						"value": "[parameters('LS_AzureDataLake_PAI_accountKey')]"
					},
					"LS_AzureSqlDatabase_PAI_password": {
						"value": "[parameters('LS_AzureSqlDatabase_PAI_password')]"
					},
					"LS_AzureDataLake_PAI_properties_typeProperties_url": {
						"value": "[parameters('LS_AzureDataLake_PAI_properties_typeProperties_url')]"
					},
					"LS_AzureSqlDatabase_PAI_properties_typeProperties_server": {
						"value": "[parameters('LS_AzureSqlDatabase_PAI_properties_typeProperties_server')]"
					},
					"LS_AzureSqlDatabase_PAI_properties_typeProperties_database": {
						"value": "[parameters('LS_AzureSqlDatabase_PAI_properties_typeProperties_database')]"
					},
					"LS_AzureSqlDatabase_PAI_properties_typeProperties_userName": {
						"value": "[parameters('LS_AzureSqlDatabase_PAI_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}