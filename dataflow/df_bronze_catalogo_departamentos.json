{
	"name": "df_bronze_catalogo_departamentos",
	"properties": {
		"folder": {
			"name": "bronze"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "catalogo_departamentos_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "HECHOS_VACUNACION",
						"type": "DatasetReference"
					},
					"name": "DestinoSilverDepartamentos"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          municipio_id as string,",
				"          municipio_nombre as string,",
				"          departamento as string,",
				"          codigo_departamento as string,",
				"          zona_geografica as string,",
				"          es_capital_departamental as string,",
				"          poblacion_depto_estimada as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(municipio_nombre = trim(upper(municipio_nombre)),",
				"          departamento = trim(upper(departamento)),",
				"          es_capital_departamental = toBoolean(es_capital_departamental),",
				"          poblacion_depto_estimada = toInteger(poblacion_depto_estimada)) ~> derivedColumn1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          id_hecho as string,",
				"          paciente_id as string,",
				"          vacuna_id as string,",
				"          establecimiento_id as string,",
				"          fecha_id as date,",
				"          numero_dosis as double,",
				"          lote as string,",
				"          edad_dias as double",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> DestinoSilverDepartamentos"
			]
		}
	}
}