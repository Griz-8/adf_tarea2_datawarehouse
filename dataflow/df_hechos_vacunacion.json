{
	"name": "df_hechos_vacunacion",
	"properties": {
		"folder": {
			"name": "bronze"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "vacunacion_la_paz_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "vacunacion_santa_cruz_csv",
						"type": "DatasetReference"
					},
					"name": "source2"
				},
				{
					"dataset": {
						"referenceName": "vacunacion_rural_movil_csv",
						"type": "DatasetReference"
					},
					"name": "source3"
				},
				{
					"dataset": {
						"referenceName": "DIM_PACIENTE",
						"type": "DatasetReference"
					},
					"name": "srcPaciente"
				},
				{
					"dataset": {
						"referenceName": "DIM_VACUNA",
						"type": "DatasetReference"
					},
					"name": "srcVacuna"
				},
				{
					"dataset": {
						"referenceName": "DIM_ESTABLECIMIENTO",
						"type": "DatasetReference"
					},
					"name": "srcEstablecimiento"
				},
				{
					"dataset": {
						"referenceName": "DIM_TIEMPO",
						"type": "DatasetReference"
					},
					"name": "srcTiempo"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "union1"
				},
				{
					"name": "select2"
				},
				{
					"name": "select3"
				},
				{
					"name": "select4"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "joinPaciente"
				},
				{
					"name": "joinVacuna"
				},
				{
					"name": "joinEstablecimiento"
				},
				{
					"name": "joinTiempo"
				}
			],
			"scriptLines": [
				"source(output(",
				"          id_registro as string,",
				"          cod_paciente as string,",
				"          documento_identidad as string,",
				"          nombres as string,",
				"          primer_apellido as string,",
				"          segundo_apellido as string,",
				"          genero as string,",
				"          fec_nacimiento as string,",
				"          municipio as string,",
				"          pueblo_indigena as string,",
				"          fec_vacunacion as string,",
				"          cod_vacuna as string,",
				"          desc_vacuna as string,",
				"          nro_dosis as integer,",
				"          cod_establecimiento as string,",
				"          desc_establecimiento as string,",
				"          depto as string,",
				"          nro_lote as string,",
				"          temp_conservacion as string,",
				"          edad_dias as string,",
				"          via_aplicacion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source(output(",
				"          registro_id as string,",
				"          paciente_id as string,",
				"          ci_paciente as string,",
				"          nombre_paciente as string,",
				"          apellido_paterno as string,",
				"          apellido_materno as string,",
				"          sexo as string,",
				"          fecha_nacimiento as string,",
				"          municipio_residencia as string,",
				"          comunidad_indigena as string,",
				"          fecha_vacunacion as string,",
				"          vacuna_id as string,",
				"          vacuna_nombre as string,",
				"          numero_dosis as integer,",
				"          establecimiento_id as string,",
				"          nombre_establecimiento as string,",
				"          departamento as string,",
				"          lote_vacuna as string,",
				"          temperatura_conservacion as double,",
				"          edad_dias_aplicacion as short,",
				"          aplicacion_oportuna as boolean,",
				"          via_administracion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source2",
				"source(output(",
				"          record_id as string,",
				"          sync_timestamp as string,",
				"          device_id as string,",
				"          patient_id as string,",
				"          patient_ci as string,",
				"          patient_name as string,",
				"          patient_last_name_1 as string,",
				"          patient_last_name_2 as string,",
				"          patient_sex as string,",
				"          patient_birth_date as string,",
				"          patient_department as string,",
				"          patient_municipality as string,",
				"          patient_community as string,",
				"          patient_indigenous as string,",
				"          vaccination_date as string,",
				"          vaccine_code as string,",
				"          vaccine_name as string,",
				"          dose_number as integer,",
				"          facility_code as string,",
				"          facility_name as string,",
				"          lot_number as string,",
				"          storage_temp_celsius as string,",
				"          patient_age_days as string,",
				"          administration_route as string,",
				"          gps_latitude as string,",
				"          gps_longitude as string,",
				"          gps_accuracy_meters as string,",
				"          observations as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source3",
				"source(output(",
				"          paciente_id as string,",
				"          ci as string,",
				"          nombres as string,",
				"          apellido_paterno as string,",
				"          apellido_materno as string,",
				"          genero as string,",
				"          fecha_nacimiento as date,",
				"          municipio as string,",
				"          indigena as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> srcPaciente",
				"source(output(",
				"          vacuna_id as string,",
				"          vacuna_nombre as string,",
				"          enfermedad_previene as string,",
				"          grupo_pai as string,",
				"          via_administracion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> srcVacuna",
				"source(output(",
				"          establecimiento_id as string,",
				"          nombre_establecimiento as string,",
				"          tipo_establecimiento as string,",
				"          nivel_atencion as integer,",
				"          departamento as string,",
				"          municipio as string,",
				"          red_salud as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> srcEstablecimiento",
				"source(output(",
				"          fecha_id as date,",
				"          anio as integer,",
				"          mes as integer,",
				"          dia as integer,",
				"          trimestre as integer,",
				"          dia_semana as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> srcTiempo",
				"select4, select3, select2 union(byName: true)~> union1",
				"derivedColumn2 select(mapColumn(",
				"          id_registro = record_id,",
				"          sync_timestamp,",
				"          device_id,",
				"          paciente_id = patient_id,",
				"          ci = patient_ci,",
				"          nombres = patient_name,",
				"          apellido_paterno = patient_last_name_1,",
				"          apellido_materno = patient_last_name_2,",
				"          genero = patient_sex,",
				"          fecha_nacimiento = patient_birth_date,",
				"          depto = patient_department,",
				"          municipio = patient_municipality,",
				"          patient_community,",
				"          indigena = patient_indigenous,",
				"          fec_vacunacion = vaccination_date,",
				"          cod_vacuna = vaccine_code,",
				"          vaccine_name,",
				"          nro_dosis = dose_number,",
				"          cod_establecimiento = facility_code,",
				"          nombre_establecimiento = facility_name,",
				"          nro_lote = lot_number,",
				"          storage_temp_celsius,",
				"          patient_age_days,",
				"          via_administracion = administration_route,",
				"          observations",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"derivedColumn1 select(mapColumn(",
				"          id_registro = registro_id,",
				"          paciente_id,",
				"          ci = ci_paciente,",
				"          nombres = nombre_paciente,",
				"          apellido_paterno,",
				"          apellido_materno,",
				"          genero = sexo,",
				"          fecha_nacimiento,",
				"          municipio = municipio_residencia,",
				"          indigena = comunidad_indigena,",
				"          fec_vacunacion = fecha_vacunacion,",
				"          cod_vacuna = vacuna_id,",
				"          vacuna_nombre,",
				"          nro_dosis = numero_dosis,",
				"          cod_establecimiento = establecimiento_id,",
				"          nombre_establecimiento,",
				"          depto = departamento,",
				"          nro_lote = lote_vacuna,",
				"          edad_dias_aplicacion,",
				"          aplicacion_oportuna,",
				"          via_administracion",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3",
				"derivedColumn3 select(mapColumn(",
				"          id_registro,",
				"          paciente_id = cod_paciente,",
				"          ci = documento_identidad,",
				"          nombres,",
				"          apellido_paterno = primer_apellido,",
				"          apellido_materno = segundo_apellido,",
				"          genero,",
				"          fecha_nacimiento = fec_nacimiento,",
				"          municipio,",
				"          indigena = pueblo_indigena,",
				"          fec_vacunacion,",
				"          cod_vacuna,",
				"          nro_dosis,",
				"          cod_establecimiento,",
				"          depto,",
				"          nro_lote,",
				"          via_administracion = via_aplicacion",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select4",
				"source2 derive(fecha_nacimiento = toDate(fecha_nacimiento, 'dd/MM/yyyy')) ~> derivedColumn1",
				"source3 derive(patient_birth_date = toDate(patient_birth_date, 'yyyy-MM-dd')) ~> derivedColumn2",
				"source1 derive(fec_nacimiento = coalesce(     toDate(fec_nacimiento, 'dd/MM/yyyy'),     toDate(fec_nacimiento, 'yyyy-MM-dd') )) ~> derivedColumn3",
				"union1, srcPaciente join(union1@paciente_id == srcPaciente@paciente_id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinPaciente",
				"joinPaciente, srcVacuna join(cod_vacuna == vacuna_id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinVacuna",
				"joinVacuna, srcEstablecimiento join(cod_establecimiento == establecimiento_id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinEstablecimiento",
				"joinEstablecimiento, srcTiempo join(union1@fecha_nacimiento == fecha_id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinTiempo"
			]
		}
	}
}